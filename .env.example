## NexCare local development
##
## Copy this file to `.env` and fill in values.
## Never commit your real `.env`.

# Required for JWT auth (set to a long random string for real deployments)
JWT_SECRET=dev_jwt_secret_change_me

# Anthropic API key (optional if you use demo cache)
ANTHROPIC_API_KEY=

# Optional: force demo-cache responses (no external API calls)
FORCE_DEMO_CACHE=true

# Optional: server port
PORT=3001

